# Copy to .env (it is ignored by git) and fill in your own values.
# Only public values belong here: anything with a VITE_ prefix is visible to every visitor.
# Never put a Supabase service role key or a PayPal secret in this file.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PROJECT-PUBLISHABLE-KEY
# PayPal client id: use a SANDBOX one while testing
VITE_PAYPAL_CLIENT_ID=YOUR-PAYPAL-CLIENT-ID
